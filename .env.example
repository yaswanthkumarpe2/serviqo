# =============================================================
# SERVIQO — ENVIRONMENT VARIABLES
# =============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# ---- Application ----
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017/serviqo

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Authentication ----
# Required, no default, minimum 32 characters. Signs access tokens (HS256).
# Rotating it invalidates every access token currently in circulation.
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-characters
#
# Required, no default, minimum 32 characters. Signs WIDGET VISITOR tokens
# (HS256) — the credential a website visitor's browser holds (ADR-019 s8).
#
# This MUST be a different value from JWT_ACCESS_SECRET. The server refuses to
# start if they match: Serviqo issues two credential formats to two principal
# types, and distinct keys are what make a staff token fail widget
# verification at the SIGNATURE rather than at an audience claim. Setting both
# to one value is a mistake that produces no symptom until it produces the
# worst one.
#
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Rotating it invalidates every widget session currently in circulation, and
# each affected visitor silently becomes a NEW customer on their next page
# load. Rotate deliberately.
JWT_WIDGET_SECRET=change-me-to-a-DIFFERENT-random-string-of-at-least-32-characters
#
# Token LIFETIMES are deliberately not configurable here (ADR-011 section 11):
# a misconfigured deployment must not be able to stretch a credential's
# validity, so ACCESS_TOKEN_TTL_MS and SESSION_TTL_MS live in
# apps/server/src/config/constants.ts. Refresh tokens are opaque and
# database-backed (ADR-004), not JWTs, so there is no refresh signing secret.

# ---- Email (future) ----
